source 'https://rubygems.org'

gem 'rails', '~> 8.1.3'
gem 'puma', '>= 6.5.0'

# json 3.0 принимает опции JSON.parse только именованными аргументами, а Rails 8.1.3.1
# передаёт их хэшем из ActiveSupport::JSON.decode: ломаются jsonb-колонки, JSON-параметры
# запросов и cookies. Ограничение снять, когда Rails это исправит
gem 'json', '< 3'

# Базы данных
gem 'pg'

# Обеспечение работы представлений и JavaScript
gem 'sprockets-rails'
gem 'slim-rails'

# Управление бизнес-логикой
gem 'dry-initializer'
gem 'dry-types'

# Конфигурирование приложения
gem 'config'
gem 'dotenv', require: 'dotenv/load'

# Система администрирования
gem 'activeadmin'
gem 'activeadmin_addons'
gem 'devise'

# Интеграция с RabbitMQ
gem 'bunny'
gem 'kicks'

group :development, :test do
  gem 'bundler-audit'
  gem 'capybara'
  gem 'database_consistency', require: false
  gem 'debug', platforms: %i[ mri windows ], require: 'debug/prelude'
  gem 'fasterer'
  gem 'factory_bot_rails'
  gem 'ffaker'
  gem 'rubocop-performance', require: false
  gem 'rubocop-rails', require: false
  gem 'rubocop-rspec', require: false
  gem 'rubocop-rails-omakase', require: false
  gem 'rspec-rails', '>= 7.1'
  gem 'simplecov', require: false
  gem 'shoulda-matchers'
  gem 'pry-rails'
  gem 'pry-byebug'
end

group :development do
  gem 'web-console'
end
